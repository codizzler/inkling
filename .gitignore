# Rust build output, at the root and in the nested inkling-py workspace.
target/
**/*.rs.bk
*.pdb

# VHS recording scripts are local scaffolding; only the rendered GIFs are tracked.
*.tape

# Generated per-platform napi packages, rebuilt from package.json triples.
crates/inkling-node/npm/

# npm install output; the bindings are built in CI.
node_modules/

# Node addon build output. The binaries are built in CI, one per platform, and
# published as their own npm packages; index.js is the loader napi emits beside
# them. None of it belongs in the repository.
*.node
crates/inkling-node/artifacts/
crates/inkling-node/index.js
crates/inkling-node/index.d.ts
