{
  "name": "inkling-loader",
  "version": "0.2.0",
  "description": "Reveal ASCII art as a progress indicator, from Node, on the inkling engine.",
  "license": "MIT",
  "repository": "github:codizzler/inkling",
  "keywords": [
    "progress",
    "progress-bar",
    "ascii-art",
    "terminal",
    "cli",
    "loader",
    "spinner",
    "animation",
    "napi-rs",
    "native"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "name": "inkling",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">= 12"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "homepage": "https://codytaylor.dev/inkling"
}
